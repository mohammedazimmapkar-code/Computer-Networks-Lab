#include <stdio.h>
#include <string.h>

int main() {
    char data[100], transmit[100] = {0}, recv[100] = {0};
    
    printf("Enter Data: ");
    scanf("%s", data);

    int m = strlen(data), r = 0;
    while ((1 << r) < m + r + 1) r++;

    int n = m + r;

    for (int i = 1, d = 0; i <= n; i++) {
        if ((i & (i - 1)) == 0) continue;
        transmit[i] = data[d++];
    }

    for (int i = 0; i < r; i++) {
        int p = 1 << i, ones = 0;
        for (int j = 1; j <= n; j++) {
            if (j & p && transmit[j] == '1') ones++;
        }
        transmit[p] = (ones % 2 == 0) ? '0' : '1';
    }

    printf("Transmitted: %s\n", transmit + 1);

    printf("Enter Received Data: ");
    scanf("%s", recv + 1);

    int err_pos = 0;
    for (int i = 0; i < r; i++) {
        int p = 1 << i, ones = 0;
        for (int j = 1; j <= n; j++) {
            if (j & p && recv[j] == '1') ones++;
        }
        if (ones % 2 != 0) err_pos += p;
    }

    if (err_pos == 0) {
        printf("No error detected.\n");
    } else {
        printf("%*s^\n", err_pos - 1, "");
        printf("Error detected at bit %d\n", err_pos);
    }

    return 0;
}
